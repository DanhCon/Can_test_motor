<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="zlac_robot">

  <!-- Khung robot gốc -->
  <link name="base_link"/>

  <!-- Khớp và bánh xe trái -->
  <link name="wheel_left_link"/>
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0.0 0.225 0.0" rpy="0 0 0"/> <!-- y = 0.45m / 2 = 0.225m -->
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Khớp và bánh xe phải -->
  <link name="wheel_right_link"/>
  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0.0 -0.225 0.0" rpy="0 0 0"/> <!-- y = -0.45m / 2 = -0.225m -->
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Khai báo Plugin ros2_control kết nối tới phần cứng ZLAC8015D -->
  <ros2_control name="zlac_system" type="system">
    <hardware>
      <plugin>can_test_motor/ZlacHardwareInterface</plugin>
      <param name="stm32_ip">192.168.1.100</param>
      <param name="stm32_port">8888</param>
      <param name="wheel_radius">0.0535</param>
      <param name="wheel_base">0.45</param>
      <param name="cpr">4096</param>
      <param name="motor_b_reverse">true</param>
    </hardware>

    <joint name="wheel_left_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="wheel_right_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>